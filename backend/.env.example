NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origins autorizadas para o console web, separadas por vírgula. Deixe vazio
# quando a API não for acessada diretamente de outro origin.
CORS_ORIGINS=http://localhost:5173
# A documentação interativa é habilitada apenas fora de produção.
SWAGGER_ENABLED=true

INITIAL_PLATFORM_ADMIN_EMAIL=admin@example.com
INITIAL_PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_initial_password

DATABASE_URL=postgres://message_hub:message_hub@localhost:5432/message_hub

RABBITMQ_URL=amqp://message_hub:message_hub@localhost:5672

# ── Meta / WhatsApp (OPCIONAL) ────────────────────────────────────────────────
META_GRAPH_API_URL_BASE=https://graph.facebook.com/v25.0/
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ── Canal WhatsApp padrão do projeto ──────────────────────────────────────────
# Provider efetivo de envio: `meta` em operação normal ou `sandbox` para simulações locais.
MESSAGE_PROVIDER=meta
# Habilita os endpoints administrativos de simulação de webhook quando for `true`.
SANDBOX_ENABLED=false
META_DEFAULT_CHANNEL_ENABLED=false
META_DEFAULT_CHANNEL_TENANT_ID=
META_DEFAULT_CHANNEL_TENANT_NAME=Canal padrão da plataforma
MESSAGING_DEFAULT_PROVIDER=meta
META_DEFAULT_CHANNEL_APPLICATION_NAME=Console padrão da plataforma
META_DEFAULT_CHANNEL_WABA_ID=
META_DEFAULT_CHANNEL_BEARER=
META_DEFAULT_CHANNEL_PHONE_NUMBER_ID=
META_DEFAULT_CHANNEL_PHONE_NUMBER=
META_DEFAULT_CHANNEL_USERNAME=

# Chave da aplicação para cifrar credenciais próprias de tenants no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# ── Alertas de engenharia (opcionais) ─────────────────────────────────────────
# E-mail usa o webhook do gateway corporativo; o Hub envia somente metadados técnicos mínimos.
ENGINEERING_SLACK_WEBHOOK_URL=
ENGINEERING_TEAMS_WEBHOOK_URL=
ENGINEERING_EMAIL_WEBHOOK_URL=
