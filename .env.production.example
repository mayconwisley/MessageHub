# Copie este arquivo para .env no servidor de producao e preencha todos os valores.
# Nunca versione o arquivo .env resultante e nunca reutilize as credenciais abaixo.

# Exposicao local para o reverse proxy. O TLS termina no proxy.
BACKEND_PORT=3000
FRONTEND_PORT=8080

POSTGRES_USER=message_hub
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA
POSTGRES_DB=message_hub

RABBITMQ_USER=message_hub
RABBITMQ_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA

# Backup do Postgres (ver scripts/backup-postgres.sh e README.md).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_REMOTE_DIR=usuario@host:/backups/message-hub

NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://console.seu-dominio.com.br
SWAGGER_ENABLED=false
TRUST_PROXY=true

INITIAL_PLATFORM_ADMIN_EMAIL=admin@seu-dominio.com.br
INITIAL_PLATFORM_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_COM_PELO_MENOS_12_CARACTERES

MESSAGE_PROVIDER=meta
SANDBOX_ENABLED=false

META_GRAPH_API_URL_BASE=https://graph.facebook.com/v25.0/
META_WEBHOOK_VERIFY_TOKEN=SUBSTITUA_POR_UM_TOKEN_ALEATORIO
META_APP_SECRET=SUBSTITUA_PELO_APP_SECRET_DA_META
META_CREDENTIALS_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_32_BYTES

# Preencha somente se a conta Meta padrao for gerenciada pelo ambiente.
META_DEFAULT_CHANNEL_ENABLED=false
META_DEFAULT_CHANNEL_TENANT_ID=
META_DEFAULT_CHANNEL_TENANT_NAME=
META_DEFAULT_CHANNEL_APPLICATION_NAME=
META_DEFAULT_CHANNEL_WABA_ID=
META_DEFAULT_CHANNEL_BEARER=
META_DEFAULT_CHANNEL_PHONE_NUMBER_ID=
META_DEFAULT_CHANNEL_PHONE_NUMBER=
META_DEFAULT_CHANNEL_USERNAME=

SMTP_DEFAULT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Message Hub

ENGINEERING_SLACK_WEBHOOK_URL=
ENGINEERING_TEAMS_WEBHOOK_URL=
ENGINEERING_EMAIL_WEBHOOK_URL=

# URL publica que o navegador consegue acessar, nao o hostname interno do Docker.
VITE_API_URL=https://api.seu-dominio.com.br
