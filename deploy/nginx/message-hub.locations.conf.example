# Inclua estas locations dentro do server HTTPS existente de www.mcnwly.com.br.
# O proxy_pass com barra final remove o prefixo público antes de encaminhar.

location = /messagehub {
    return 308 /messagehub/;
}

location = /messagehub/api {
    return 308 /messagehub/api/;
}

location ^~ /messagehub/api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
}

location ^~ /messagehub/assets/ {
    # Ajuste /opt/message-hub para o diretório real de deploy da aplicação.
    root /opt/message-hub/runtime/public;
    try_files $uri =404;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /messagehub/ {
    # Os arquivos ficam em <deploy>/runtime/public/messagehub para que a URI
    # pública e o caminho abaixo de root coincidam.
    root /opt/message-hub/runtime/public;
    try_files $uri $uri/ /messagehub/index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
}
