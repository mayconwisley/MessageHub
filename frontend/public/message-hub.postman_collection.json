{
  "info": { "name": "Message Hub - Integração", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "wh_live_SUBSTITUA_AQUI" }
