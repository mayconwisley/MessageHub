# Copie para .env na VPS e substitua todos os placeholders.
# Este perfil pressupõe PostgreSQL, RabbitMQ e Nginx rodando diretamente no Linux.

BACKEND_PORT=3000
# Diretório preenchido pelo container one-shot e servido diretamente pelo Nginx do host.
FRONTEND_PUBLIC_DIR=./runtime/public/messagehub

NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://www.mcnwly.com.br
SWAGGER_ENABLED=false
TRUST_PROXY=true

# Como backend e migration usam network_mode: host, os serviços locais ficam
# acessíveis por 127.0.0.1. Codifique caracteres especiais da senha na URL.
DATABASE_URL=postgresql://message_hub:SUBSTITUA_POR_UMA_SENHA_FORTE@127.0.0.1:5432/message_hub
RABBITMQ_URL=amqp://message_hub:SUBSTITUA_POR_UMA_SENHA_FORTE@127.0.0.1:5672/message_hub

INITIAL_PLATFORM_ADMIN_EMAIL=admin@mcnwly.com.br
INITIAL_PLATFORM_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_COM_PELO_MENOS_12_CARACTERES

MESSAGE_PROVIDER=meta
SANDBOX_ENABLED=false

META_GRAPH_API_URL_BASE=https://graph.facebook.com/v25.0/
META_WEBHOOK_VERIFY_TOKEN=SUBSTITUA_POR_UM_TOKEN_ALEATORIO
META_APP_SECRET=SUBSTITUA_PELO_APP_SECRET_DA_META
META_CREDENTIALS_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_32_BYTES

META_DEFAULT_CHANNEL_ENABLED=false
META_DEFAULT_CHANNEL_TENANT_ID=
META_DEFAULT_CHANNEL_TENANT_NAME=
META_DEFAULT_CHANNEL_APPLICATION_NAME=
META_DEFAULT_CHANNEL_WABA_ID=
META_DEFAULT_CHANNEL_BEARER=
META_DEFAULT_CHANNEL_PHONE_NUMBER_ID=
META_DEFAULT_CHANNEL_PHONE_NUMBER=
META_DEFAULT_CHANNEL_USERNAME=

SMTP_DEFAULT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Message Hub

ENGINEERING_SLACK_WEBHOOK_URL=
ENGINEERING_TEAMS_WEBHOOK_URL=
ENGINEERING_EMAIL_WEBHOOK_URL=

# Ambas são incorporadas ao bundle durante o build do frontend.
VITE_API_URL=https://www.mcnwly.com.br/messagehub/api
VITE_BASE_PATH=/messagehub/
