NODE_ENV=development
PORT=3000
LOG_LEVEL=info

INITIAL_PLATFORM_ADMIN_EMAIL=admin@example.com
INITIAL_PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_initial_password

DATABASE_URL=postgres://message_hub:message_hub@localhost:5432/message_hub

RABBITMQ_URL=amqp://message_hub:message_hub@localhost:5672

# ── Meta / WhatsApp (OPCIONAL) ────────────────────────────────────────────────
META_GRAPH_API_URL_BASE=https://graph.facebook.com/v25.0/
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ── Canal WhatsApp padrão do projeto ──────────────────────────────────────────
MESSAGING_DEFAULT_PROVIDER=meta
META_DEFAULT_CHANNEL_ENABLED=false
META_DEFAULT_CHANNEL_WABA_ID=
META_DEFAULT_CHANNEL_BEARER=
META_DEFAULT_CHANNEL_PHONE_NUMBER_ID=
META_DEFAULT_CHANNEL_PHONE_NUMBER=
META_DEFAULT_CHANNEL_USERNAME=

# Chave da aplicação para cifrar credenciais próprias de tenants no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_32_byte_key
