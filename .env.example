# Configuração do Docker Compose (docker-compose.yml / docker-compose.prod.yml).
#
# Copie para `.env` na raiz do projeto para sobrescrever os padrões:
#   cp .env.example .env
#
# Sem esse arquivo, `docker compose up --build` já sobe o ambiente completo
# com valores padrão de TESTE (não usar em produção). Este arquivo é
# independente de backend/.env e frontend/.env, usados para desenvolvimento
# local sem Docker.

# ── Portas publicadas no host ─────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=message_hub
POSTGRES_PASSWORD=message_hub
POSTGRES_DB=message_hub

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=message_hub
RABBITMQ_PASSWORD=message_hub

# ── Backend (Message Hub API) ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Se mudar FRONTEND_PORT, atualize este valor para o mesmo host:porta do console.
CORS_ORIGINS=http://localhost:8080
SWAGGER_ENABLED=true
TRUST_PROXY=false

INITIAL_PLATFORM_ADMIN_EMAIL=admin@example.com
INITIAL_PLATFORM_ADMIN_PASSWORD=ChangeMe123!Hub

# `sandbox` simula o envio ao WhatsApp e não exige credenciais reais da Meta -
# ideal para apenas testar a aplicação. Troque para `meta` (e preencha as
# credenciais abaixo) para operar de fato.
MESSAGE_PROVIDER=sandbox
SANDBOX_ENABLED=true

META_GRAPH_API_URL_BASE=https://graph.facebook.com/v25.0/
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

META_DEFAULT_CHANNEL_ENABLED=false
META_DEFAULT_CHANNEL_TENANT_ID=
META_DEFAULT_CHANNEL_TENANT_NAME=
META_DEFAULT_CHANNEL_APPLICATION_NAME=
META_DEFAULT_CHANNEL_WABA_ID=
META_DEFAULT_CHANNEL_BEARER=
META_DEFAULT_CHANNEL_PHONE_NUMBER_ID=
META_DEFAULT_CHANNEL_PHONE_NUMBER=
META_DEFAULT_CHANNEL_USERNAME=

# Chave usada para cifrar credenciais de tenants no banco (AES-256-GCM).
# O valor abaixo é só um exemplo válido para TESTE LOCAL. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_CREDENTIALS_ENCRYPTION_KEY=YdY22vFhvdlUKe4gEPrAJ9rxxJh4M6vI1ZHjjkRGtPk=

# ── SMTP padrão (fallback global para e-mails) ──────────────────────────────
# Quando habilitado, é usado pelos tenants que não cadastraram SMTP próprio.
# Credenciais específicas do tenant são cifradas no banco com a chave acima.
SMTP_DEFAULT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true normalmente somente para SMTPS na porta 465; para 587 use false (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Message Hub

ENGINEERING_SLACK_WEBHOOK_URL=
ENGINEERING_TEAMS_WEBHOOK_URL=
ENGINEERING_EMAIL_WEBHOOK_URL=

# ── Frontend (console web) ───────────────────────────────────────────────────
# Embutido no bundle em tempo de build (Vite) - precisa ser alcançável pelo
# NAVEGADOR do usuário, não pela rede interna do Docker. Se mudar BACKEND_PORT,
# atualize este valor também.
VITE_API_URL=http://localhost:3000
